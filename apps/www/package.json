{
  "name": "www",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "content-collections build && react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "npm run cf-typegen",
    "preview": "npm run build && vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "npm run cf-typegen && npx react-router typegen && npx tsc -b",
    "db:studio": "LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:prod": "dotenv -- drizzle-kit studio",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply --local db",
    "db:migrate-prod": "dotenv -- drizzle-kit migrate",
    "db:seed": "LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) tsx scripts/seed.ts",
    "auth:db:generate": "better-auth generate --config scripts/auth.gen.ts --output app/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@content-collections/cli": "^0.1.9",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-select": "^2.3.7",
    "@tabler/icons-react": "^3.48.0",
    "better-auth": "^1.7.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "isbot": "^5.2.2",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "spotify-api.js": "^9.2.5",
    "tailwind-merge": "^3.7.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@content-collections/core": "^0.15.3",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/remix-vite": "^0.3.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-arm64-musl": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0"
  }
}
