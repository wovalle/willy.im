/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idp-willy-im",
  "account_id": "d5705803ba3e46be8c7b0566e47ff7d6",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "BETTER_AUTH_URL": "https://idp.willy.im",
    // Vanity IdP hostnames also served by this worker (see docs/custom-domains.md).
    // Each needs DNS/TLS: a custom-domain route below (zone on this account),
    // Cloudflare for SaaS, or a Host-preserving reverse proxy.
    "IDP_EXTRA_DOMAINS": "idp.kasso.do",
    // Discord OAuth, for self-service identity linking (/link/discord). The
    // client id is public (it is in every authorize URL); the secret is a
    // Worker secret — `wrangler secret put DISCORD_CLIENT_SECRET`. This is the
    // same Discord application as the bender bot: one app, a bot half and an
    // OAuth2 half. Redirect URI registered with Discord:
    // https://idp.willy.im/auth/callback/discord
    "DISCORD_CLIENT_ID": "1545640954562871467",
    // Error reporting goes to GlitchTip (bugs.romo.fyi, org kasso, project idp)
    // when the Worker secret GLITCHTIP_DSN is set —
    // `wrangler secret put GLITCHTIP_DSN`. Unset ⇒ nothing is reported.
  },
  // The deployed Worker version; the Sentry SDK reports it as the release.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "idp-willy-im",
      "database_id": "7a13019b-235f-4408-bdea-eead1d81778e",
      "migrations_dir": "drizzle",
      // drizzle-kit v1 writes one folder per migration: drizzle/<ts>_<name>/migration.sql
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "routes": [
    {
      "pattern": "idp.willy.im",
      "custom_domain": true,
    },
  ],
}
