{
  "name": "idp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "npm run cf-typegen",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "npm run cf-typegen && npx react-router typegen && npx tsc -b",
    "db:studio": "LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply --local db",
    "db:migrate-prod": "wrangler d1 migrations apply --remote db",
    "auth:db:generate": "better-auth generate --config scripts/auth.gen.ts --output app/db/auth-schema.ts --yes",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sentry/cloudflare": "^11.4.0",
    "@willyim/idp": "*",
    "@willyim/kit": "*",
    "better-auth": "^1.7.7",
    "blobatar": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "isbot": "^5.2.2",
    "luchy": "^0.2.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "resend": "^6.32.0",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tiny-invariant": "^1.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
