{
  "name": "@willyim/drizzle-audit",
  "version": "0.9.0",
  "description": "Deprecated: use @willyim/kit/audit",
  "deprecated": "@willyim/drizzle-audit is part of @willyim/kit now. Install @willyim/kit and import from \"@willyim/kit/audit\" (and /audit/context, /audit/d1, /audit/d1-runtime, /audit/postgres); the CLI is `kit-audit`.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./d1-runtime": {
      "types": "./dist/d1-runtime.d.ts",
      "default": "./dist/d1-runtime.js"
    }
  },
  "bin": {
    "drizzle-audit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "audit",
    "audit-log",
    "postgres",
    "d1",
    "sqlite",
    "cloudflare",
    "triggers"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wovalle/willy.im",
    "directory": "packages/drizzle_audit"
  },
  "dependencies": {
    "@willyim/kit": "^0.2.0"
  },
  "peerDependencies": {
    "drizzle-kit": ">=1.0.0-0",
    "drizzle-orm": ">=1.0.0-0"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
