{
  "name": "@willyim/kit",
  "version": "0.5.2",
  "description": "Write a capability once as a typed method; serve it to your UI, an HTTP API, MCP and any agent runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./idp": {
      "types": "./dist/idp/index.d.ts",
      "default": "./dist/idp/index.js"
    },
    "./idp/drizzle": {
      "types": "./dist/idp/drizzle.d.ts",
      "default": "./dist/idp/drizzle.js"
    },
    "./idp/react-router": {
      "types": "./dist/idp/react-router.d.ts",
      "default": "./dist/idp/react-router.js"
    },
    "./idp/schemas": {
      "types": "./dist/idp/schemas.d.ts",
      "default": "./dist/idp/schemas.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./audit/context": {
      "types": "./dist/audit/context/index.d.ts",
      "default": "./dist/audit/context/index.js"
    },
    "./audit/d1": {
      "types": "./dist/audit/d1/index.d.ts",
      "default": "./dist/audit/d1/index.js"
    },
    "./audit/d1-runtime": {
      "types": "./dist/audit/d1-runtime/index.d.ts",
      "default": "./dist/audit/d1-runtime/index.js"
    },
    "./audit/postgres": {
      "types": "./dist/audit/postgres/index.d.ts",
      "default": "./dist/audit/postgres/index.js"
    },
    "./audit/cli": {
      "types": "./dist/audit/cli/generate-migration.d.ts",
      "default": "./dist/audit/cli/generate-migration.js"
    }
  },
  "bin": {
    "kit-audit": "./dist/audit/cli/generate-migration.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "AUDIT.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.audit.json && cp -R src/idp dist/idp",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/consumer",
    "test": "vitest run"
  },
  "keywords": [
    "rpc",
    "mcp",
    "openapi",
    "agents",
    "rbac",
    "permissions",
    "zod",
    "react-router",
    "cloudflare-workers",
    "drizzle",
    "audit-log"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wovalle/willy.im.git",
    "directory": "packages/kit"
  },
  "dependencies": {
    "@willyim/idp": "0.8.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "drizzle-kit": ">=1.0.0-0",
    "drizzle-orm": ">=1.0.0-0",
    "react": ">=18",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "miniflare": "^4.20260410.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
