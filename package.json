{
  "name": "willy.im",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=www",
    "compose": "docker compose up",
    "build": "npm run build --workspaces",
    "postbuild": "npm run postbuild --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "packages:build": "npm run build -w @willyim/idp -w @willyim/kit -w @willyim/rbac -w @willyim/drizzle-audit -w @willyim/drizzle-repositories",
    "packages:typecheck": "npm run typecheck -w @willyim/idp -w @willyim/kit -w @willyim/rbac -w @willyim/drizzle-audit -w @willyim/drizzle-repositories",
    "packages:test": "npm run test --if-present -w @willyim/idp -w @willyim/kit -w @willyim/rbac -w @willyim/drizzle-audit -w @willyim/drizzle-repositories",
    "changeset": "changeset",
    "release": "npm run packages:build && changeset publish",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "workspaces": [
    "packages/idp-client",
    "packages/kit",
    "packages/rbac",
    "packages/drizzle_audit",
    "packages/drizzle_repositories",
    "apps/www",
    "apps/idp"
  ],
  "license": "MIT"
}
